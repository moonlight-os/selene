# Qt dlopens its plugins and resolves QML imports at runtime, so
# dpkg-shlibdeps cannot see either and both have to be named by hand below.
# qt6-svg-plugins carries the SVG image format plugin and icon engine:
# libqt6svg6 alone is just the library, and without the plugins every icon in
# the UI silently fails to render while text still draws normally.
# qt6-wayland is the Wayland platform plugin -- without it Qt finds no usable
# platform under a compositor and the client does not start at all.
Package: selene
Architecture: amd64
Depends: ${shlibs:Depends},
         ${misc:Depends},
         qt6-svg-plugins,
         qt6-wayland,
         qml6-module-qtquick,
         qml6-module-qtquick-controls,
         qml6-module-qtquick-templates,
         qml6-module-qtquick-layouts,
         qml6-module-qtquick-window,
         qml6-module-qtqml-workerscript,
         libqt6svg6
Description: Game streaming client for Moonlight OS
 Selene is the client half of the Selene/Helios game streaming pair used by
 Moonlight OS. It is a hard fork of moonlight-qt, built natively for Debian
 rather than shipped as an AppImage, so it uses the system's Qt, SDL, FFmpeg
 and VA-API libraries directly.
